<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Products</title>
  <%- include("style") %>
</head>
<body>
  <div class="box">
    <h1>Products</h1>
    <a class="btn" href="/products/new">+ Add Product</a>
    <br><br>

    <% if (products.length === 0) { %>
      <p>No products yet.</p>
    <% } else { %>
      <table>
        <tr><th>ID</th><th>Name</th><th>Price</th><th>Actions</th></tr>
        <% products.forEach(function(p) { %>
          <tr>
            <td><%= p.id %></td>
            <td><%= p.name %></td>
            <td>Rs. <%= p.price %></td>
            <td>
              <a class="btn" href="/products/<%= p.id %>">View</a>
              <a class="btn" href="/products/<%= p.id %>/edit">Edit</a>
              <form class="inline" action="/products/<%= p.id %>?_method=DELETE" method="POST">
                <button class="danger" type="submit">Delete</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </table>
    <% } %>
  </div>
</body>
</html>
