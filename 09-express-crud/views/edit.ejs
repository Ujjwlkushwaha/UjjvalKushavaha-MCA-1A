<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Edit Product</title>
  <%- include("style") %>
</head>
<body>
  <div class="box">
    <h1>Edit Product</h1>
    <form action="/products/<%= product.id %>?_method=PUT" method="POST">
      <label>Name</label>
      <input type="text" name="name" value="<%= product.name %>" required>
      <label>Price</label>
      <input type="number" name="price" min="0" value="<%= product.price %>" required>
      <label>Description</label>
      <textarea name="description" rows="3" required><%= product.description %></textarea>
      <button type="submit">Update</button>
      <a class="btn" href="/products">Cancel</a>
    </form>
  </div>
</body>
</html>
