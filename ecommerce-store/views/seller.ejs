<%- include("partials/header") %>

<div class="bar">
  <h1 class="page-title">Seller panel</h1>
  <div class="actions">
    <a class="btn" href="/seller/products/new">Add product</a>
    <form method="post" action="/seller/logout"><button class="btn ghost">Log out</button></form>
  </div>
</div>

<h2 class="section">Products</h2>
<div class="scroll">
  <table>
    <thead>
      <tr><th>Name</th><th>Category</th><th class="num">Price</th><th class="num">Stock</th><th></th></tr>
    </thead>
    <tbody>
      <% products.forEach(function(p) { %>
        <tr>
          <td><%= p.name %></td>
          <td><%= p.category %></td>
          <td class="num"><%= money(p.price) %></td>
          <td class="num <%= p.stock <= 5 ? 'warn' : '' %>"><%= p.stock %></td>
          <td class="end">
            <a href="/seller/products/<%= p.id %>/edit">Edit</a>
            <form class="inline" method="post" action="/seller/products/<%= p.id %>/delete"
                  onsubmit="return confirm('Remove this product?')">
              <button class="link">Delete</button>
            </form>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<h2 class="section">Orders received</h2>
<% if (orders.length === 0) { %>
  <p class="muted">No orders yet.</p>
<% } else { %>
  <div class="scroll">
    <table>
      <thead>
        <tr><th>Order</th><th>Date</th><th>Customer</th><th>Items</th><th>Payment</th><th class="num">Total</th></tr>
      </thead>
      <tbody>
        <% orders.forEach(function(o) { %>
          <tr>
            <td>#<%= o.id %></td>
            <td><%= fmtDate(o.date) %></td>
            <td><%= o.customer.name %>, <%= o.customer.city %></td>
            <td><%= o.items.map(function(i) { return i.name + " × " + i.qty; }).join(", ") %></td>
            <td><%= o.payment.method %></td>
            <td class="num"><%= money(o.total) %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include("partials/footer") %>
